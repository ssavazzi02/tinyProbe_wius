			)
			(justify left top)
		)
		(uuid "019dbf82-e6f4-4d6f-a105-1708fb442540")
	)
	(text_box "Power tree and configurations:\n\nhttps://t.ly/lrq2h\n\nPower scenario: resistors to place\n------------------------------\nAll from battery, 1.8V: R12\nAll from battery, 3.3V: R21\nVIO from TinyProbe:   R19\nMCU 3.3V only:           R19, R21"
		(exclude_from_sim no)
		(at 17.78 142.24 0)
		(size 48.26 27.94)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
			(color 0 0 0 1)
		)
		(fill
