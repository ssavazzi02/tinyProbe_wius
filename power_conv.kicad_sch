				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "171e79ad-23a1-440f-9fd9-c744e94fc774")
	)
	(text_box "Dev board (BRD4002A + BRD4338A) has around 20uF capacitance on VMCU line (VIO + 3.3V).\n\nThis board:\n3.3V: 21.2uF\n1.8V: 23.6uF\n"
		(exclude_from_sim no)
		(at 167.64 165.1 0)
		(size -50.8 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
